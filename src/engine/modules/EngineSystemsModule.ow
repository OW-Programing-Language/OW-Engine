import "../systems/SystemRegistry.ow"

class EngineSystemsModule(Module):
  field registry

  fn new():
    set this.registry: new SystemRegistry()

  fn name():
    return: "engine.systems"

  fn requires():
    return: ["components", "scenes"]

  fn register(app):
    call: app.require_as("engine.systems", "components", "ENGINE_COMPONENTS")
    call: app.require_as("engine.systems", "scenes", "ENGINE_SCENES")
    return: app.provide_as("systems", "ENGINE_SYSTEMS", this.registry)

  fn start(app):
    return: 0

  fn stop(app):
    return: 0

  fn reload(app):
    return: 0

  fn on_event(type, payload):
    return: 0

  fn store():
    return: this.registry
