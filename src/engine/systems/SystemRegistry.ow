import "EngineSystem.ow"

# Stable insertion-order system scheduling. Disabling a system preserves its slot.
class SystemRegistry:
  field systems
  field enabled
  field size_value

  fn new():
    set this.systems: array(32, 0)
    set this.enabled: array(32, 0)
    set this.size_value: 0

  fn index_of(name):
    set i int: 0
    while: i < this.size_value
      if: this.systems[i].name() == name
        return: i
      set i: i + 1
    return: (0 - 1)

  fn register(system):
    set checked EngineSystem: system
    if: checked.name() == ""
      return: 0
    if: this.index_of(checked.name()) >= 0
      return: 0
    if: this.size_value >= len(this.systems)
      return: 0
    set registered: this.systems
    set flags: this.enabled
    set registered[this.size_value]: checked
    set flags[this.size_value]: 1
    set this.size_value: this.size_value + 1
    return: 1

  fn set_enabled(name, state):
    set idx int: this.index_of(name)
    if: idx < 0
      return: 0
    set flags: this.enabled
    if: state == 0
      set flags[idx]: 0
    else:
      set flags[idx]: 1
    return: 1

  fn run(scenes, components, delta_ms):
    if: delta_ms < 0
      return: 0
    set i int: 0
    while: i < this.size_value
      if: this.enabled[i] == 1
        set system: this.systems[i]
        if: system.update(scenes, components, delta_ms) == 0
          return: 0
      set i: i + 1
    return: 1

  fn count():
    return: this.size_value
