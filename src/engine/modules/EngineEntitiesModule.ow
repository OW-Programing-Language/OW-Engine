import "../entities/EntityStore.ow"

# flOW classic Module: entity storage is provided as an explicit service.
class EngineEntitiesModule(Module):
  field storage

  fn new():
    set this.storage: new EntityStore()

  fn name():
    return: "engine.entities"

  fn requires():
    return: []

  fn register(app):
    return: app.provide_as("entities", "ENGINE_ENTITIES", this.storage)

  fn start(app):
    return: 0

  fn stop(app):
    return: 0

  fn reload(app):
    return: 0

  fn on_event(type, payload):
    return: 0

  fn store():
    return: this.storage
