# Deterministic fixed-step simulation driver, in integer milliseconds.
# Clock source and real-time window pumping belong to the application layer.
class FixedStepLoop:
  field scenes
  field interval_ms
  field accumulator_ms
  field ticks
  field max_steps
  field systems
  field components
  field systems_attached
  field events
  field events_attached

  fn new(scenes, interval_ms):
    call: assert(interval_ms > 0, "fixed step must be positive")
    set this.scenes: scenes
    set this.interval_ms: interval_ms
    set this.accumulator_ms: 0
    set this.ticks: 0
    set this.max_steps: 8
    set this.systems: 0
    set this.components: 0
    set this.systems_attached: 0
    set this.events: 0
    set this.events_attached: 0

  fn attach_events(events):
    if: this.events_attached == 1
      return: 0
    set this.events: events
    set this.events_attached: 1
    return: 1

  fn attach_systems(systems, components):
    if: this.systems_attached == 1
      return: 0
    set this.systems: systems
    set this.components: components
    set this.systems_attached: 1
    return: 1

  fn update(elapsed_ms):
    if: elapsed_ms < 0
      return: (0 - 1)
    # Prevent a large frame stall from producing unbounded simulation work.
    set time: this.accumulator_ms + elapsed_ms
    set limit: this.interval_ms * this.max_steps
    if: time > limit
      set time: limit
    set this.accumulator_ms: time
    set executed int: 0
    while: this.accumulator_ms >= this.interval_ms
      if: this.systems_attached == 1
        if: this.systems.run(this.scenes, this.components, this.interval_ms) == 0
          return: (0 - 1)
      if: this.scenes.tick() == 0
        return: (0 - 1)
      set this.accumulator_ms: this.accumulator_ms - this.interval_ms
      set this.ticks: this.ticks + 1
      if: this.events_attached == 1
        if: this.events.publish("engine.tick", this.ticks) == 0
          return: (0 - 1)
      set executed: executed + 1
    return: executed

  fn tick_count():
    return: this.ticks

  fn pending_ms():
    return: this.accumulator_ms

  fn step_ms():
    return: this.interval_ms
