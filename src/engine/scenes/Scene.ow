# A scene owns a set of entity IDs, not a graphics context.
class Scene:
  field label
  field ids
  field size_value
  field ticks

  fn new(label):
    set this.label: label
    set this.ids: array(128, 0)
    set this.size_value: 0
    set this.ticks: 0

  fn name():
    return: this.label

  fn size():
    return: this.size_value

  fn contains(id):
    set i int: 0
    while: i < this.size_value
      if: this.ids[i] == id
        return: 1
      set i: i + 1
    return: 0

  fn add(id):
    if: id < 1
      return: 0
    if: this.contains(id) == 1
      return: 0
    if: this.size_value >= len(this.ids)
      return: 0
    set stored: this.ids
    set stored[this.size_value]: id
    set this.size_value: this.size_value + 1
    return: 1

  fn remove(id):
    set i int: 0
    while: i < this.size_value
      if: this.ids[i] == id
        set stored: this.ids
        set j int: i
        while: j < this.size_value - 1
          set stored[j]: stored[j + 1]
          set j: j + 1
        set stored[this.size_value - 1]: 0
        set this.size_value: this.size_value - 1
        return: 1
      set i: i + 1
    return: 0

  fn entity_at(index):
    if: index < 0
      return: 0
    if: index >= this.size_value
      return: 0
    return: this.ids[index]

  fn advance():
    set this.ticks: this.ticks + 1
    return: 1

  fn tick_count():
    return: this.ticks
