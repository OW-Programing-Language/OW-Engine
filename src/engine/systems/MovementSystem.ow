import "EngineSystem.ow"

# Only updates entities in the ACTIVE scene with both transform and velocity.
# Velocity units are world units / second; delta_ms comes from FixedStepLoop.
class MovementSystem(EngineSystem):
  fn name():
    return: "movement"

  fn update(scenes, components, delta_ms):
    if: delta_ms < 0
      return: 0
    set seconds: delta_ms / 1000.0
    set i int: 0
    while: i < scenes.active_entities()
      set id int: scenes.active_entity_at(i)
      if: components.has("transform", id) == 1
        if: components.has("velocity", id) == 1
          set transform: components.get("transform", id)
          set velocity: components.get("velocity", id)
          call: transform.translate(velocity.x * seconds, velocity.y * seconds, velocity.z * seconds)
      set i: i + 1
    return: components.sync_all_positions()
