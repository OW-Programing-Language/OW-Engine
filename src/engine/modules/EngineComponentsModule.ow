import "../components/ComponentRegistry.ow"

class EngineComponentsModule(Module):
  field registry

  fn new(entities):
    set this.registry: new ComponentRegistry(entities)

  fn name():
    return: "engine.components"

  fn requires():
    return: ["entities"]

  fn register(app):
    call: app.require_as("engine.components", "entities", "ENGINE_ENTITIES")
    return: app.provide_as("components", "ENGINE_COMPONENTS", this.registry)

  fn start(app):
    return: 0

  fn stop(app):
    return: 0

  fn reload(app):
    return: 0

  fn on_event(type, payload):
    return: 0

  fn store():
    return: this.registry
